# Copy this file to .local/cluster.env and fill in your scheduler settings.
# This file is sourced as trusted shell configuration.
QLDPC_SLURM_ACCOUNT=''
QLDPC_SLURM_PARTITION=''

# Optional connection metadata for local operators. The submit helper does not SSH.
QLDPC_SSH_TARGET=''
QLDPC_SSH_CONTROL_PATH=''
QLDPC_CLUSTER_ROOT=''
QLDPC_ARCHIVE_CLUSTER_ROOT=''

# Optional site tools. Otherwise use zstd from PATH and curl's default trust store.
QLDPC_ZSTD=''
QLDPC_CURL_CA_BUNDLE=''
