import Mathlib.Algebra.Polynomial.Div
import Mathlib.Algebra.Polynomial.Degree.Domain
import Mathlib.Algebra.Polynomial.AlgebraMap
import Mathlib.Algebra.Polynomial.Bivariate
import Mathlib.Algebra.CharP.Two
import Mathlib.Data.ZMod.Basic
import Mathlib.Tactic

/-!
# Polynomial bulk exactness for the rectangular 722 model

The inner polynomial variable is Y and the outer variable is X. This file
proves the syzygy statement in ordinary bivariate polynomials, using monic
division and a nonzero two-by-two determinant over the coefficient domain.
It assumes neither coprimality nor a Bezout identity. In particular, it does
not incorrectly assert that the ideal generated by f and g is the whole ring.

The generic division argument is valid over every commutative domain. Its
signed formulas specialize to the characteristic-two formulas in the notes.
This is not yet Laurent-polynomial exactness or a finite-matrix adapter.
-/

namespace QldpcVerification.Planar.BulkExactness

open Polynomial

noncomputable section

section Generic

variable {R : Type*} [CommRing R] [IsDomain R]

def quadratic (s : R) : R[X] := X ^ 2 + X + C s
def companion (t : R) : R[X] := C t * X ^ 2 + 1

theorem quadratic_monic (s : R) : (quadratic s).Monic := by
  have h : (X + C s : R[X]).degree < (2 : ℕ) := by
    rw [degree_X_add_C]
    norm_num
  simpa [quadratic, add_assoc] using (monic_X_pow_add h)

theorem quadratic_degree (s : R) : (quadratic s).degree = (2 : ℕ) := by
  have h : (X + C s : R[X]).degree < (X ^ 2 : R[X]).degree := by
    rw [degree_X_add_C, degree_X_pow]
    norm_num
  simpa [quadratic, add_assoc] using (degree_add_eq_left_of_degree_lt h)

theorem quadratic_natDegree (s : R) : (quadratic s).natDegree = 2 :=
  natDegree_eq_of_degree_eq_some (quadratic_degree s)

theorem linear_degree_lt_two (a b : R) :
    (C a + C b * X : R[X]).degree < (2 : ℕ) := by
  apply lt_of_le_of_lt (degree_add_le _ _)
  apply max_lt
  · exact lt_of_le_of_lt degree_C_le (by norm_num)
  · exact lt_of_le_of_lt (degree_C_mul_X_le b) (by norm_num)

/-- The generic signed remainder matrix is nonsingular when its determinant is nonzero. -/
theorem remainder_matrix_injective (s t r₀ r₁ : R)
    (hd : (1 - s * t) ^ 2 + t ≠ 0)
    (h₀ : (1 - t * s) * r₀ + t * s * r₁ = 0)
    (h₁ : -t * r₀ + (1 - t * s + t) * r₁ = 0) : r₀ = 0 ∧ r₁ = 0 := by
  have he₀ : ((1 - s * t) ^ 2 + t) * r₀ = 0 := by
    linear_combination (1 - t * s + t) * h₀ - t * s * h₁
  have he₁ : ((1 - s * t) ^ 2 + t) * r₁ = 0 := by
    linear_combination t * h₀ + (1 - t * s) * h₁
  exact ⟨(mul_eq_zero.mp he₀).resolve_left hd, (mul_eq_zero.mp he₁).resolve_left hd⟩

/-- Cancellation modulo the monic quadratic, proved by division, not assumed coprimality. -/
theorem quadratic_dvd_of_dvd_companion_mul (s t : R)
    (hd : (1 - s * t) ^ 2 + t ≠ 0) (u : R[X])
    (hu : quadratic s ∣ companion t * u) : quadratic s ∣ u := by
  let r := u %ₘ quadratic s
  let r₀ := r.coeff 0
  let r₁ := r.coeff 1
  have hr : r = C r₀ + C r₁ * X := by
    have h := sum_modByMonic_coeff (p := u) (q := quadratic s)
      (n := 2) (quadratic_monic s) (le_of_eq (quadratic_degree s))
    simpa [Fin.sum_univ_two, monomial_zero_left, ← C_mul_X_eq_monomial,
      r, r₀, r₁] using h.symm
  have hgr : quadratic s ∣ companion t * r := by
    dsimp only [r]
    rw [modByMonic_eq_sub_mul_div, mul_sub]
    apply dvd_sub hu
    refine ⟨companion t * (u /ₘ quadratic s), ?_⟩
    ring
  let L : R[X] := C ((1 - t * s) * r₀ + t * s * r₁) +
    C (-t * r₀ + (1 - t * s + t) * r₁) * X
  let q : R[X] := C (t * r₁) * X + C (t * (r₀ - r₁))
  have hidentity : L = companion t * r - quadratic s * q := by
    rw [hr]
    dsimp [L, q, companion, quadratic]
    simp only [map_add, map_sub, map_mul, map_neg, map_one]
    ring
  have hLdvd : quadratic s ∣ L := by
    rw [hidentity]
    exact dvd_sub hgr ⟨q, rfl⟩
  have hLdegree : L.degree < (quadratic s).degree := by
    rw [quadratic_degree]
    exact linear_degree_lt_two _ _
  have hL : L = 0 := eq_zero_of_dvd_of_degree_lt hLdvd hLdegree
  have h₀ : (1 - t * s) * r₀ + t * s * r₁ = 0 := by
    simpa [L] using congrArg (fun p : R[X] => p.coeff 0) hL
  have h₁ : -t * r₀ + (1 - t * s + t) * r₁ = 0 := by
    simpa [L, coeff_one] using congrArg (fun p : R[X] => p.coeff 1) hL
  obtain ⟨hr₀, hr₁⟩ := remainder_matrix_injective s t r₀ r₁ hd h₀ h₁
  apply (modByMonic_eq_zero_iff_dvd (quadratic_monic s)).mp
  change r = 0
  simp [hr, hr₀, hr₁]

end Generic

abbrev F2 := ZMod 2
abbrev A := Polynomial F2
abbrev Bivariate := Polynomial A

/-- Inner variable Y. The unqualified polynomial X at type `Bivariate` is outer X. -/
def Y : A := Polynomial.X
def t : A := Y + Y ^ 2
def f : Bivariate := quadratic (Y ^ 2)
def g : Bivariate := companion t

theorem f_monic : f.Monic := quadratic_monic _
theorem f_ne_zero : f ≠ 0 := f_monic.ne_zero
theorem f_natDegree : f.natDegree = 2 := quadratic_natDegree _

/-- The eliminant has constant coefficient one; no finite evaluation enumeration is used. -/
theorem eliminant_ne_zero : (1 - Y ^ 2 * t) ^ 2 + t ≠ 0 := by
  intro h
  have he := congrArg (Polynomial.eval (0 : F2)) h
  simpa [Y, t] using he

/-- Divisibility by f can be cancelled across multiplication by this particular g. -/
theorem f_dvd_of_dvd_g_mul (u : Bivariate) (hu : f ∣ g * u) : f ∣ u :=
  quadratic_dvd_of_dvd_companion_mul _ _ eliminant_ne_zero u hu

/-- Full-plane polynomial syzygy: every cycle is a multiple of the bulk generator. -/
theorem bulk_exactness (u v : Bivariate) (hcycle : g * u + f * v = 0) :
    ∃ h : Bivariate, u = f * h ∧ v = g * h := by
  have hgu : g * u = -(f * v) := eq_neg_of_add_eq_zero_left hcycle
  have hdiv : f ∣ g * u := by
    rw [hgu]
    exact dvd_neg.mpr ⟨v, rfl⟩
  obtain ⟨h, hu⟩ := f_dvd_of_dvd_g_mul u hdiv
  refine ⟨h, hu, ?_⟩
  have he : f * (g * h + v) = 0 := by
    rw [hu] at hcycle
    calc
      f * (g * h + v) = g * (f * h) + f * v := by ring
      _ = 0 := hcycle
  have hv : g * h + v = 0 := (mul_eq_zero.mp he).resolve_left f_ne_zero
  have hv' : v = -(g * h) := eq_neg_of_add_eq_zero_right hv
  simpa only [CharTwo.neg_eq] using hv'

/-- Conversely every bulk-generator multiple is a cycle, in characteristic two. -/
theorem bulk_cycle (h : Bivariate) : g * (f * h) + f * (g * h) = 0 := by
  have he : g * (f * h) = f * (g * h) := by ring
  rw [he, CharTwo.add_self_eq_zero]

theorem bulk_exactness_iff (u v : Bivariate) :
    g * u + f * v = 0 ↔ ∃ h : Bivariate, u = f * h ∧ v = g * h := by
  constructor
  · exact bulk_exactness u v
  · rintro ⟨h, rfl, rfl⟩
    exact bulk_cycle h

/-- The bulk generator coefficient is unique, by cancellation in the polynomial domain. -/
theorem bulk_exactness_unique (u v : Bivariate) (hcycle : g * u + f * v = 0) :
    ∃! h : Bivariate, u = f * h ∧ v = g * h := by
  obtain ⟨h, hu, hv⟩ := bulk_exactness u v hcycle
  refine ⟨h, ⟨hu, hv⟩, ?_⟩
  intro k hk
  exact mul_left_cancel₀ f_ne_zero (hk.1.symm.trans hu)

/-- Outer X degree shrinks by two. This includes the zero polynomial. -/
theorem quotient_natDegree_le {u h : Bivariate} {L : ℕ}
    (hu : u = f * h) (hdegree : u.natDegree ≤ L + 2) : h.natDegree ≤ L := by
  by_cases hh : h = 0
  · simp [hh]
  have he : u.natDegree = 2 + h.natDegree := by
    rw [hu, natDegree_mul f_ne_zero hh, f_natDegree]
  omega

/-- For a cycle with outer degree at most 18, its unique generator has outer degree at most 16.
The transverse Y support bound is a separate obligation, not implicit in this theorem. -/
theorem bulk_exactness_outer_support (u v : Bivariate)
    (hcycle : g * u + f * v = 0) (hdegree : u.natDegree ≤ 18) :
    ∃ h : Bivariate, u = f * h ∧ v = g * h ∧ h.natDegree ≤ 16 := by
  obtain ⟨h, hu, hv⟩ := bulk_exactness u v hcycle
  exact ⟨h, hu, hv, quotient_natDegree_le hu hdegree⟩

/-- Interchange the ordinary polynomial variables. -/
def swap : Bivariate ≃ₐ[F2] Bivariate := Polynomial.Bivariate.swap

theorem swap_f : swap f = (X : Bivariate) ^ 2 + C (Y ^ 2 + Y) := by
  simp only [swap, f, quadratic, Y, map_add, map_pow,
    Polynomial.Bivariate.swap_X, Polynomial.Bivariate.swap_Y]
  ring

theorem swap_f_natDegree : (swap f).natDegree = 2 := by
  rw [swap_f]
  exact natDegree_X_pow_add_C

/-- The coefficient of X^i Y^j becomes that of X^j Y^i after swapping. -/
theorem swap_coeff (p : Bivariate) (i j : ℕ) :
    ((swap p).coeff j).coeff i = (p.coeff i).coeff j := by
  induction p using Polynomial.induction_on' with
  | add p q hp hq => simp [map_add, hp, hq]
  | monomial n a =>
    induction a using Polynomial.induction_on' with
    | add a b ha hb => simp [map_add, ha, hb]
    | monomial m c =>
      simp only [swap, Polynomial.Bivariate.swap_monomial_monomial, coeff_monomial]
      split_ifs <;> simp_all [coeff_monomial]

/-- The transverse Y degree shrinks by two as well. -/
theorem quotient_swapped_natDegree_le {u h : Bivariate} {L : ℕ}
    (hu : u = f * h) (hdegree : (swap u).natDegree ≤ L + 2) :
    (swap h).natDegree ≤ L := by
  by_cases hh : swap h = 0
  · simp [hh]
  have hf : swap f ≠ 0 := by
    intro he
    apply f_ne_zero
    apply swap.injective
    simpa using he
  have he : (swap u).natDegree = 2 + (swap h).natDegree := by
    rw [hu, map_mul, natDegree_mul hf hh, swap_f_natDegree]
  omega

/-- Ordinary nonnegative exponents are bounded in both coordinates. -/
def InSquare (d : ℕ) (p : Bivariate) : Prop :=
  p.natDegree ≤ d ∧ (swap p).natDegree ≤ d

theorem inSquare_coeff_zero {d : ℕ} {p : Bivariate} (hp : InSquare d p)
    (i j : ℕ) (houtside : d < i ∨ d < j) : (p.coeff i).coeff j = 0 := by
  rcases houtside with hi | hj
  · rw [coeff_eq_zero_of_natDegree_lt (lt_of_le_of_lt hp.1 hi)]
    simp
  · rw [← swap_coeff]
    rw [coeff_eq_zero_of_natDegree_lt (lt_of_le_of_lt hp.2 hj)]
    simp

/-- An untruncated product f*h supported in a square forces h into the smaller square. -/
theorem quotient_inSquare {u h : Bivariate} {L : ℕ}
    (hu : u = f * h) (hdegree : InSquare (L + 2) u) : InSquare L h :=
  ⟨quotient_natDegree_le hu hdegree.1, quotient_swapped_natDegree_le hu hdegree.2⟩

/-- Polynomial bulk cycles in the 19 by 19 board have a generator in the 17 by 17 square.
This concerns the full polynomial syndrome, not a truncated boundary syndrome. -/
theorem bulk_exactness_square (u v : Bivariate)
    (hcycle : g * u + f * v = 0) (hu : InSquare 18 u) :
    ∃ h : Bivariate, u = f * h ∧ v = g * h ∧ InSquare 16 h := by
  obtain ⟨h, he, hv⟩ := bulk_exactness u v hcycle
  exact ⟨h, he, hv, quotient_inSquare he hu⟩

/-- Coefficient form of the 17 by 17 generator-support conclusion. -/
theorem bulk_exactness_square_coeff (u v : Bivariate)
    (hcycle : g * u + f * v = 0) (hu : InSquare 18 u) :
    ∃ h : Bivariate, u = f * h ∧ v = g * h ∧
      ∀ i j, 17 ≤ i ∨ 17 ≤ j → (h.coeff i).coeff j = 0 := by
  obtain ⟨h, he, hv, hs⟩ := bulk_exactness_square u v hcycle hu
  refine ⟨h, he, hv, ?_⟩
  intro i j hij
  exact inSquare_coeff_zero hs i j (by omega)

end

end QldpcVerification.Planar.BulkExactness
