  "additional_findings": {
    "formalized": [
      "Logical pairing is preserved without physical weight preservation.",
      "An increasing example shows exact distance need not stay constant.",
      "In the preserving example a canonical Z lift grows from weight2 to3 although both exact Z distances are2."
    ],
    "derived_not_formalized": [
      "The overall distance loses at most one per elementary deletion.",
      "A Z stabilizer b with odd s dot b can correct z before lifting without weight increase if twice the support overlap is at least weight(b).",
      "The X increase is at most max(q-1,0), where q is the least weight in s+row(A).",
      "Fixed-side repeated deletions have asymmetric accumulated lower bounds."
    ],
    "novelty": "No novelty claim; compare Grassl arXiv2208.05353v2 Theorems4-5 and Gundersen et al. arXiv2410.17754v3."
  },
