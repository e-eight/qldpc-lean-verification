  "normal_form": {
    "retained": "Any binary CSS matrices A,B on n qubits with A*B^T=0.",
    "old_X": "Rows (a_i,0) and the distinguished row (s,1).",
    "old_Z": "Rows (b_j,s dot b_j).",
    "removed_coordinate": "Last physical qubit.",
    "operation": "Elementary X-check qubit removal in row-normalized fan-out coordinates.",
    "no_automatic_recognition": "An application must prove that its original physical matrices fit the normal form; arbitrary Clifford equivalence is insufficient."
  },
  "formal_results": {
    "ranks": "rank_X_old=rank_X_new+1; rank_Z_old=rank_Z_new.",
    "encoded_dimension": "Preserved.",
    "X_lift": "Append a zero; logical nontriviality and physical Hamming weight are preserved.",
    "Z_lift": "Append s dot z; logical nontriviality is preserved and physical weight increases by zero or one.",
    "all_X_lifts": "(x+t*s,t), t in F2.",
    "pairing": "Both X lifts pair with the Z lift exactly as x pairs with z.",
    "distance_comparison": "d_X_old <= d_X_new; d_Z_new <= d_Z_old <= d_Z_new+1, when the exact minima exist.",
    "X_preservation": "Given new X distance D, equality iff every new X logical x satisfies D <= weight(x+s)+1.",
    "Z_preservation": "Given new Z distance D, equality iff some shortest new Z logical z has s dot z=0.",
    "Z_loss": "Old Z distance is D+1 iff every shortest new Z logical of weight D has s dot z nonzero.",
    "same_definitions": "Input.CSSCode distance predicates, with the existing proved Input.Homological bridge to QECLean."
  },
